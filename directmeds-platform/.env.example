PORT=8788
HOST=127.0.0.1
# Set to the PostgreSQL connection string from the dedicated DirectMeds database.
DATABASE_URL=
# Neon requires TLS. Set PGSSL=disable only for local non-TLS PostgreSQL.
PGSSL=require
PGSSL_REJECT_UNAUTHORIZED=true
PGPOOL_MAX=5
# Keep synthetic analytics enabled until approved DirectMeds sources are connected.
DEMO_MODE=true
OPENAI_API_KEY=
OPENAI_MODEL=
