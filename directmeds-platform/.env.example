PORT=8788
HOST=127.0.0.1
# For a public bind (0.0.0.0), set a random secret of at least 32 characters.
ADMIN_API_TOKEN=
DATABASE_URL=
PGSSL=require
PGSSL_REJECT_UNAUTHORIZED=true
PGPOOL_MAX=5
# The analytics agent uses this key only server-side; never place it in the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AGENT_TIMEOUT_MS=20000
AGENT_MAX_CONCURRENT_RUNS=1
